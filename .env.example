# TaskFlow by Utsav - Environment Variables

# MongoDB Atlas Database URI (Optional - app runs 100% offline-first via local storage if omitted)
MONGO_DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# JWT Secret for cookie authentication
JWT_TOKEN=your_secure_random_jwt_secret_here

# Base URL (Optional - defaults to relative URL in browser)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Pluggable AI Integration (Optional - falls back to built-in heuristic decomposition if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
